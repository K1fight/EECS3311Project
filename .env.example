# Environment Configuration for EECS3311 Project
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword

# Server Configuration
SERVER_PORT=8080
FRONTEND_PORT=3000

# AI Chatbot Configuration (Optional - for Phase 2 AI integration)
# Uncomment and add your API key for real AI integration
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# AI_MODEL=gpt-3.5-turbo

# Docker Configuration
DOCKER_NETWORK=eecs-network
POSTGRES_IMAGE=postgres:15
JAVA_IMAGE=eclipse-temurin:17-jdk-alpine
